<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="MailApp">
  <Id>e3bcab2e-f66a-4e25-98fd-9f9cd0dc65df</Id><Version>1.0.0.0</Version><ProviderName>Aaron Cousland</ProviderName><DefaultLocale>en-AU</DefaultLocale>
  <DisplayName DefaultValue="Agora"/><Description DefaultValue="Save conversations and keep track of your promises in your local personal CRM."/>
  <IconUrl DefaultValue="https://localhost:3848/icon-64.png"/><HighResolutionIconUrl DefaultValue="https://localhost:3848/icon-80.png"/>
  <SupportUrl DefaultValue="https://github.com/acousland/Agora/issues"/>
  <AppDomains><AppDomain>https://localhost:3848</AppDomain></AppDomains>
  <Hosts><Host Name="Mailbox"/></Hosts><Requirements><Sets><Set Name="Mailbox" MinVersion="1.1"/></Sets></Requirements>
  <FormSettings><Form xsi:type="ItemRead"><DesktopSettings><SourceLocation DefaultValue="https://localhost:3848/taskpane.html"/><RequestedHeight>450</RequestedHeight></DesktopSettings></Form></FormSettings>
  <Permissions>ReadItem</Permissions><Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/><DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.3"><bt:Set Name="Mailbox"/></bt:Sets></Requirements>
    <Hosts><Host xsi:type="MailHost"><DesktopFormFactor>
      <FunctionFile resid="Taskpane.Url"/>
      <ExtensionPoint xsi:type="MessageReadCommandSurface"><OfficeTab id="TabDefault"><Group id="Agora.Group"><Label resid="Group.Label"/>
        <Control xsi:type="Button" id="Agora.Capture"><Label resid="Button.Label"/><Supertip><Title resid="Button.Label"/><Description resid="Button.Tooltip"/></Supertip>
          <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
          <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
        </Control>
      </Group></OfficeTab></ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images><bt:Image id="Icon.16" DefaultValue="https://localhost:3848/icon-16.png"/><bt:Image id="Icon.32" DefaultValue="https://localhost:3848/icon-32.png"/><bt:Image id="Icon.80" DefaultValue="https://localhost:3848/icon-80.png"/></bt:Images>
      <bt:Urls><bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3848/taskpane.html"/></bt:Urls>
      <bt:ShortStrings><bt:String id="Group.Label" DefaultValue="Agora"/><bt:String id="Button.Label" DefaultValue="Save to Agora"/></bt:ShortStrings>
      <bt:LongStrings><bt:String id="Button.Tooltip" DefaultValue="Save this email and register your commitments in Agora on this Mac."/></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
